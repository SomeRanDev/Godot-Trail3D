[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d_debug.so"
linux.release.x86_64 =   "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d.so"
windows.debug.x86_64 =   "res://addons/SomeRanDev.Trail3D/godot_trail_3d_debug.dll"
windows.release.x86_64 = "res://addons/SomeRanDev.Trail3D/godot_trail_3d.dll"
macos.debug =            "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d_debug.dylib"
macos.release =          "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d.dylib"
macos.debug.arm64 =      "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d_debug.dylib"
macos.release.arm64 =    "res://addons/SomeRanDev.Trail3D/libgodot_trail_3d.dylib"
web.debug.wasm32 =       "res://addons/SomeRanDev.Trail3D/godot_trail_3d_debug.wasm"
web.release.wasm32 =     "res://addons/SomeRanDev.Trail3D/godot_trail_3d.wasm"
